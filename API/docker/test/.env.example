# docker/test ortamı için örnek değerler.
# `cp .env.example .env` yapıp doldurun. `.env` commit edilmez.

# --- MySQL (konteyner içi: mysql:3306, host makineden: 127.0.0.1:3308) ---
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me

# --- Redis (konteyner içi: redis:6379, host makineden: 127.0.0.1:6381) ---
REDIS_PASSWORD=change-redis-me

# --- API bağlantıları (servis adları ve iç portlar üzerinden) ---
ConnectionStrings__MySql=Server=mysql;Port=3306;Database=ecommerce;User=ecommerce_app;Password=change-me;SslMode=Preferred
Redis__ConnectionString=redis:6379,password=change-redis-me,abortConnect=false

# --- Güvenlik sırları: her biri 32 byte base64. Üretmek için: openssl rand -base64 32
SecuritySecrets__HmacPepperBase64=
SecuritySecrets__EncryptionKeyBase64=

# --- JWT ---
# Anahtarlar docker/test/secrets/jwt/ altında durur: private.pem + public/<keyId>.pem
# Jwt__CurrentKeyId, public/ içindeki dosya adıyla (uzantısız) eşleşmelidir.
Jwt__Issuer=ecommerce-api
Jwt__Audience=ecommerce-clients
Jwt__CurrentKeyId=key-2026-01

# --- Mail (mailpit arayüzü: http://127.0.0.1:8026) ---
Smtp__FromAddress=no-reply@ecommerce.local

# --- Başlangıçta örnek veri (yalnızca Development ortamında etkili) ---
SeedOnStartup=true
