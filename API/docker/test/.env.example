# ============================================================================
# docker/test ortamı — TÜM ayarlar bu dosyadadır, compose'da sabit değer yoktur.
#
#   cp .env.example .env   →  aşağıdaki BOŞ alanları doldurun  →  docker compose up -d
#
# .env gitignore'ludur, commit edilmez.
# ============================================================================

# --- Ağ ---------------------------------------------------------------------
# 127.0.0.1 = yalnızca bu makineden erişilir. Ağdaki başka cihazlardan
# erişilsin isterseniz 0.0.0.0 yapın (dikkat: parolalar zayıfsa açığa çıkar).
BIND_ADDRESS=127.0.0.1

API_PORT=5082          # dev konteyneri 5081, lokal `dotnet run` 5080 kullanıyor
MYSQL_PORT=3308        # dev stack'i 3307 kullanıyor
REDIS_PORT=6381        # dev stack'i 6380 kullanıyor
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026   # → http://127.0.0.1:8026

# --- İmajlar ----------------------------------------------------------------
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine
MAILPIT_IMAGE=axllent/mailpit:v1.21

# --- Ortam ------------------------------------------------------------------
# Development: Swagger UI ve SeedOnStartup açılır. Başka bir değer verirseniz
# Swagger kapanır ve şema otomatik uygulanmaz.
ASPNETCORE_ENVIRONMENT=Development
TZ=UTC
SeedOnStartup=true

# --- İlk admin hesabı -------------------------------------------------------
# Kayıt uçlarından (register/customer, register/seller) admin AÇILAMAZ; admin
# uçlarına ilk erişim yalnızca buradan gelir. Email boş bırakılırsa admin
# oluşturulmaz. E-posta zaten kayıtlıysa hesaba dokunulmaz.
# Parola en az 12 karakter olmalıdır. Hesap doğrulanmış (IsEmailVerified) açılır,
# yani OTP beklemeden doğrudan /auth/login ile giriş yapılabilir.
Seed__Admin__Email=admin@ecommerce.local
Seed__Admin__Password=change-me-admin-12
Seed__Admin__FirstName=System
Seed__Admin__LastName=Admin
Seed__Admin__PhoneNumber=0000000000

# --- MySQL ------------------------------------------------------------------
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci
MYSQL_ISOLATION=READ-COMMITTED

# --- Redis ------------------------------------------------------------------
REDIS_PASSWORD=change-redis-me

# --- API bağlantıları -------------------------------------------------------
# Servis adları ve KONTEYNER İÇİ portlar kullanılır (3306/6379), yukarıdaki
# host portları değil. Parolalar yukarıdakilerle aynı olmalı.
ConnectionStrings__MySql=Server=mysql;Port=3306;Database=ecommerce;User=ecommerce_app;Password=change-me;SslMode=Preferred
Redis__ConnectionString=redis:6379,password=change-redis-me,abortConnect=false
Redis__InstancePrefix=ecommerce:v1:

# --- Güvenlik sırları (ZORUNLU) ---------------------------------------------
# Her biri 32 baytlık base64. Üretmek için:  openssl rand -base64 32
SecuritySecrets__HmacPepperBase64=
SecuritySecrets__EncryptionKeyBase64=

# --- JWT --------------------------------------------------------------------
# Anahtarlar docker/test/secrets/jwt/ altında durur:
#   secrets/jwt/private.pem
#   secrets/jwt/public/<Jwt__CurrentKeyId>.pem
# Üretmek için:
#   mkdir -p secrets/jwt/public
#   openssl genrsa -out secrets/jwt/private.pem 2048
#   openssl rsa -in secrets/jwt/private.pem -pubout -out secrets/jwt/public/key-2026-01.pem
Jwt__Issuer=ecommerce-api
Jwt__Audience=ecommerce-clients
Jwt__CurrentKeyId=key-2026-01
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- E-posta (SMTP) ---------------------------------------------------------
# VARSAYILAN: Mailpit. Gönderilen e-postalar DIŞARI ÇIKMAZ, yakalanır ve
# http://127.0.0.1:8026 adresinde görüntülenir. Test ortamında doğrusu budur:
# gerçek insanlara test e-postası gitmez.
#
# Konteyner içi port 1025 kullanılır (host'taki MAILPIT_SMTP_PORT değil).
Smtp__Host=mailpit
Smtp__Port=1025
Smtp__UseTls=false
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=no-reply@ecommerce.local
Smtp__FromName=ECommerce

# ---- Gerçek SMTP kullanmak isterseniz (Gmail örneği) ----
# DİKKAT: Bu durumda e-postalar gerçekten gönderilir. Test verisiyle çalışırken
# yanlış adreslere posta gitmemesine dikkat edin.
#
# Gmail normal hesap parolasını KABUL ETMEZ; "Uygulama Parolası" gerekir:
#   1. Google Hesabı → Güvenlik → 2 Adımlı Doğrulama'yı açın (zorunlu)
#   2. Google Hesabı → Güvenlik → Uygulama Parolaları → yeni parola üretin
#   3. Üretilen 16 karakterli parolayı Smtp__Password'e yazın (boşluksuz)
#
# Smtp__Host=smtp.gmail.com
# Smtp__Port=587
# Smtp__UseTls=true
# Smtp__UserName=hesabiniz@gmail.com
# Smtp__Password=<16-karakterli-uygulama-parolasi>
# Smtp__FromAddress=hesabiniz@gmail.com
# Smtp__FromName=ECommerce
#
# Diğer sağlayıcılar: SendGrid (smtp.sendgrid.net:587, kullanıcı adı "apikey"),
# Mailgun (smtp.mailgun.org:587), Amazon SES (email-smtp.<bölge>.amazonaws.com:587).
# Hepsinde port 587 + UseTls=true (STARTTLS) çalışır.

# --- Doğrulama kodu (OTP) ---------------------------------------------------
Otp__LifetimeMinutes=5
Otp__MaxAttempts=5
Otp__ResendCooldownSeconds=60

# --- Depolama ---------------------------------------------------------------
Storage__MaxPhotoBytes=5242880   # 5 MB

# --- CORS -------------------------------------------------------------------
# Frontend'in adresi. Tarayıcıdan API'ye istek atacaksanız gereklidir.
ALLOWED_ORIGIN=http://localhost:3000
