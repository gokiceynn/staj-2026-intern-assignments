# ============================================================================
# docker/prod ortamı — TÜM ayarlar bu dosyadadır, compose'da sabit değer yoktur.
#
#   cp .env.example .env  →  doldurun  →  chmod 600 .env  →  docker compose up -d
#
# .env gitignore'ludur. Sunucuda dosya izinlerini mutlaka kısıtlayın:
#   chmod 600 .env
# ============================================================================

# --- İmajlar ----------------------------------------------------------------
API_IMAGE=registry.example.com/ecommerce-api
IMAGE_TAG=                       # ZORUNLU: deploy edilecek etiket, ör. 1.4.2
NGINX_IMAGE=nginx:1.27-alpine
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7.4-alpine

# --- Ağ ---------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# --- Ortam ------------------------------------------------------------------
# Production: Swagger kapalıdır ve migration açılışta ÇALIŞMAZ.
# Şemayı deploy adımında migration bundle ile uygulayın.
ASPNETCORE_ENVIRONMENT=Production
TZ=UTC

# --- MySQL ------------------------------------------------------------------
# Parolalar burada DEĞİL, external Docker secret'larındadır:
#   mysql_app_password, mysql_root_password
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_0900_ai_ci
MYSQL_ISOLATION=READ-COMMITTED

# --- API bağlantıları -------------------------------------------------------
# Servis adları `backend` ağı üzerinden çözülür. Parolalar secret'lardakiyle
# aynı olmalıdır (uygulama bağlantı dizesini dosyadan okuyamaz).
ConnectionStrings__MySql=Server=mysql;Port=3306;Database=ecommerce;User=ecommerce_app;Password=<mysql_app_password>;SslMode=Required
Redis__ConnectionString=redis:6379,password=<redis_password>,abortConnect=false
Redis__InstancePrefix=ecommerce:v1:

# --- Güvenlik sırları (ZORUNLU) ---------------------------------------------
# Her biri 32 baytlık base64:  openssl rand -base64 32
# DİKKAT: EncryptionKeyBase64 değişirse şifreli outbox kayıtları OKUNAMAZ HALE GELİR.
# HmacPepperBase64 değişirse mevcut kullanıcılar giriş yapamaz.
SecuritySecrets__HmacPepperBase64=
SecuritySecrets__EncryptionKeyBase64=

# --- JWT --------------------------------------------------------------------
# Anahtarlar `jwt` adlı external volume'dan gelir:
#   /run/secrets/jwt/private.pem
#   /run/secrets/jwt/public/<Jwt__CurrentKeyId>.pem
# Anahtar döndürürken eski public anahtarı public/ altında bırakın; böylece
# hâlâ geçerli olan token'lar doğrulanmaya devam eder.
Jwt__Issuer=ecommerce-api
Jwt__Audience=ecommerce-clients
Jwt__CurrentKeyId=key-2026-01
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# --- E-posta (SMTP) — ZORUNLU -----------------------------------------------
# Bunlar boşsa kayıt ve parola sıfırlama akışları SESSİZCE ÇALIŞMAZ:
# doğrulama kodları gönderilemez, kullanıcı hesabını aktive edemez.
# Prod'da Mailpit KULLANILMAZ; gerçek bir SMTP sağlayıcısı gerekir.
#
# Gmail: normal hesap parolası kabul edilmez, "Uygulama Parolası" gerekir.
#   1. Google Hesabı → Güvenlik → 2 Adımlı Doğrulama'yı açın (zorunlu)
#   2. Google Hesabı → Güvenlik → Uygulama Parolaları → yeni parola üretin
#   3. 16 karakterli parolayı boşluksuz olarak Smtp__Password'e yazın
#
#   Smtp__Host=smtp.gmail.com / Port=587 / UseTls=true
#
# NOT: Gmail'in günlük gönderim limiti (~500) vardır ve toplu işlemsel e-posta
# için tasarlanmamıştır. Ciddi trafikte SendGrid, Mailgun veya Amazon SES kullanın:
#   SendGrid    smtp.sendgrid.net:587      UserName=apikey, Password=<API key>
#   Mailgun     smtp.mailgun.org:587
#   Amazon SES  email-smtp.<bölge>.amazonaws.com:587
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__UseTls=true
Smtp__UserName=
Smtp__Password=
Smtp__FromAddress=
Smtp__FromName=ECommerce

# --- Doğrulama kodu (OTP) ---------------------------------------------------
Otp__LifetimeMinutes=5
Otp__MaxAttempts=5
Otp__ResendCooldownSeconds=60

# --- Depolama ---------------------------------------------------------------
Storage__MaxPhotoBytes=5242880   # 5 MB

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGIN=https://example.com
