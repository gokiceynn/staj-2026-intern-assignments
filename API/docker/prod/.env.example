# docker/prod ortamı için örnek değerler.
# `cp .env.example .env` yapıp doldurun. `.env` commit edilmez.
#
# DİKKAT: MySQL/Redis şifreleri buraya YAZILMAZ. Onlar docker swarm/compose
# external secret olarak sağlanır (docker-compose.yml içindeki `secrets:` bölümü):
#   mysql_app_password, mysql_root_password, redis_password
# JWT anahtarları ve TLS sertifikaları da external volume'lardan gelir: `jwt`, `tls`

# Deploy edilecek imaj etiketi
IMAGE_TAG=

# Servis adları docker-compose.yml içindeki `backend` ağına göre çözülür.
ConnectionStrings__MySql=Server=mysql;Port=3306;Database=ecommerce;User=ecommerce_app;Password=<mysql_app_password>;SslMode=Required
Redis__ConnectionString=redis:6379,password=<redis_password>,abortConnect=false,ssl=false

# 32 byte base64 (openssl rand -base64 32). Sır yöneticisinden enjekte edin.
SecuritySecrets__HmacPepperBase64=
SecuritySecrets__EncryptionKeyBase64=
